# Environment Configuration - NEVER commit this file
# Copy to .env and fill in real values

# Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=antigaspi
DATABASE_USER=antigaspi
DATABASE_PASSWORD=antigaspi_dev_2024

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_SECRET=dev-secret-change-in-production-abc123xyz
JWT_EXPIRATION=7d

# OTP
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS_PER_HOUR=5

# SMS Provider (provider-agnostic interface)
SMS_PROVIDER=console
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# Payment PSP (mock sandbox by default)
PAYMENT_PROVIDER=mock
