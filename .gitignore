# Root .gitignore — defense-in-depth
# Closes S2-03: Prevent any .env file from being tracked

# Environment files (any directory)
**/.env
**/.env.local
**/.env.*.local

# OS files
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo

# Debug artifacts
*.log

# Closes A1-13: Debug test files at repo root
/test.jpg
/test.txt
/test.webp
/files/
